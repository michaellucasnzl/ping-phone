<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SMS interception — RECEIVE_SMS alone provides both the message body and the
         sender number on inbound SMS, so READ_SMS is not required. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- RECEIVE_SMS implies telephony hardware; mark it optional so the app installs on
         non-telephony devices (e.g. ChromeOS tablets). -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- Audio control -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- DND override (granted via special settings screen, not runtime dialog) -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Notifications (runtime on API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Full-screen intent for the alarm dismiss screen (Android 14+ special access) -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Wake lock so alarm plays with screen off -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Boot persistence -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Needed on Android 12+ so the OS does not kill the app and miss the SMS trigger. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- allowBackup=false: alarm-app configuration should not be backed up to the cloud. -->
    <application
        android:name=".PingPhoneApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PingPhone">

        <!-- Main settings activity -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Full-screen alarm dismiss screen — shown over lock screen -->
        <activity
            android:name=".ui.AlarmDismissActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.PingPhone.AlarmDismiss" />

        <!-- SMS broadcast receiver — manifest-registered so it works when the app is not running.
             android:permission protects it so only the system (which holds BROADCAST_SMS) can trigger it. -->
        <receiver
            android:name=".receiver.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Boot receiver to restore the persistent monitoring notification -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Foreground service that plays the alarm -->
        <service
            android:name=".service.AlarmService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

    </application>

</manifest>
